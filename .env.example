# CanteenBites Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.

# Application URL
NEXT_PUBLIC_APP_URL=https://canteen-bites-ufe9.vercel.app

# Google Gemini API Key for Bites AI Assistant (Optional, fallback rule-based system enabled)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret for production session tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Node Environment
NODE_ENV=production
